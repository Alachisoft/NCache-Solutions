<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Name of the cache to connect to -->
    <add key="cacheName" value="demoCache"/>
    <!-- IP address and client port of an NCache server hosting the cache (thin client, no client.ncconf needed) -->
    <add key="cacheServer" value="20.200.20.44"/>
    <add key="cachePort" value="9800"/>
  </appSettings>
</configuration>