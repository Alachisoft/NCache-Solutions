<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="ncache" type="Alachisoft.NCache.Client.NCacheSection, Alachisoft.NCache.Client" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Name of the NCache cache to connect to -->
    <add key="CacheName" value="democache" />
  </appSettings>
  <ncache>
    <caches>
      <!-- IP address of one of the NCache servers hosting the cache and the NCache client port (default 9800) -->
      <add name="democache" server="20.200.20.44" port="9800" />
    </caches>
  </ncache>
</configuration>
