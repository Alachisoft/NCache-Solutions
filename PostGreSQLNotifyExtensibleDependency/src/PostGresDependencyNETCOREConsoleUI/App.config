<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Name of the NCache cache to connect to -->
    <add key="cacheName" value="democache" />
    <!-- IP address of one of the NCache servers hosting the cache -->
    <add key="cacheServer" value="20.200.20.44" />
    <!-- NCache client port (default 9800) -->
    <add key="cachePort" value="9800" />
  </appSettings>
</configuration>
